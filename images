<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Climora - Discover and join local climate action campaigns.">
  <title>CLIMORA | Local Climate Action</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Announcement -->
  <div class="announcement">
    🌱 Small actions create a greener future.
    <a href="#campaigns">Explore campaigns →</a>
  </div>

  <!-- Navigation -->
  <header class="navbar">
    <a href="#home" class="logo">
      <span class="logo-icon">✳</span>
      <span>CLIMORA<span class="dot">.</span>
        <small>LOCAL CLIMATE ACTION</small>
      </span>
    </a>

    <button class="menu-toggle" id="menuToggle">☰</button>

    <nav id="navLinks">
      <a href="#home">Home</a>
      <a href="#campaigns">Campaigns</a>
      <a href="#impact">Our Impact</a>
      <a href="#about">About</a>
    </nav>

    <div class="nav-actions">
      <button class="theme-button" id="themeToggle">◐</button>
      <button class="btn btn-outline" id="loginBtn">Profile</button>
      <button class="btn btn-primary" id="createBtn">+ Create Campaign</button>
    </div>
  </header>

  <main>

    <!-- Hero Section -->
    <section class="hero" id="home">
      <div class="hero-image"></div>
      <div class="hero-overlay"></div>

      <div class="hero-content">
        <span class="eyebrow light">SDG 13 · CLIMATE ACTION</span>

        <h1>
          Small Actions.<br>
          <span>Greener Future.</span>
        </h1>

        <p>
          Bring your community together to plant trees,
          clean local spaces and create awareness.
          Every action makes a difference.
        </p>

        <div class="hero-buttons">
          <a href="#campaigns" class="btn btn-lime">
            Explore Campaigns ↗
          </a>
          <button class="btn btn-glass" id="heroCreateBtn">
            + Start a Campaign
          </button>
        </div>

        <div class="hero-note">
          <span>🌱 🌍 ♻️</span>
          <div>
            <strong>Make a difference today</strong>
            <small>Take climate action in your community.</small>
          </div>
        </div>
      </div>

      <div class="hero-badge">
        <span>THINK</span>
        <strong>🌍</strong>
        <span>GLOBAL</span>
      </div>
    </section>

    <!-- Statistics -->
    <section class="stats-section">
      <div class="stat">
        <span>🌿</span>
        <div>
          <h2 id="totalCampaigns">3</h2>
          <p>Total Campaigns</p>
        </div>
      </div>

      <div class="stat">
        <span>👥</span>
        <div>
          <h2 id="totalVolunteers">0</h2>
          <p>Volunteer Registrations</p>
        </div>
      </div>

      <div class="stat">
        <span>🌳</span>
        <div>
          <h2 id="totalTrees">0</h2>
          <p>Trees Recorded</p>
        </div>
      </div>

      <div class="stat">
        <span>✓</span>
        <div>
          <h2 id="completedCampaigns">0</h2>
          <p>Completed Campaigns</p>
        </div>
      </div>
    </section>

    <!-- Campaigns -->
    <section class="section" id="campaigns">

      <div class="section-heading">
        <div>
          <span class="eyebrow">MAKE A DIFFERENCE</span>
          <h2>Discover Local <span>Campaigns.</span></h2>
          <p>Find an activity you care about and become part of the change.</p>
        </div>

        <button class="btn btn-primary" id="sectionCreateBtn">
          + Add Campaign
        </button>
      </div>

      <!-- Search -->
      <div class="toolbar">
        <div class="filters" id="filters">
          <button class="filter active" data-filter="All">All</button>
          <button class="filter" data-filter="Tree Planting">🌳 Tree Planting</button>
          <button class="filter" data-filter="Clean-up">♻️ Clean-up</button>
          <button class="filter" data-filter="Awareness">💡 Awareness</button>
          <button class="filter" data-filter="Energy">☀️ Energy</button>
        </div>

        <input
          type="search"
          id="searchInput"
          placeholder="🔍 Search campaigns..."
          aria-label="Search campaigns"
        >
      </div>

      <div class="campaign-grid" id="campaignGrid"></div>

      <div class="empty-state hidden" id="emptyState">
        <h3>🌱 No campaigns found</h3>
        <p>Try another search or category.</p>
      </div>
    </section>

    <!-- How It Works -->
    <section class="how-section" id="about">
      <div class="center-heading">
        <span class="eyebrow">HOW IT WORKS</span>
        <h2>Change Starts <span>With You.</span></h2>
        <p>Three simple steps to make a positive environmental impact.</p>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <div class="step-icon">🔍</div>
          <span class="step-number">01</span>
          <h3>Discover</h3>
          <p>Explore environmental campaigns happening in your community.</p>
        </article>

        <article class="step-card">
          <div class="step-icon">🙌</div>
          <span class="step-number">02</span>
          <h3>Participate</h3>
          <p>Register for a campaign and join other climate-conscious people.</p>
        </article>

        <article class="step-card">
          <div class="step-icon">🌳</div>
          <span class="step-number">03</span>
          <h3>Make Impact</h3>
          <p>Contribute to activities and record the results of your work.</p>
        </article>
      </div>
    </section>

    <!-- Impact -->
    <section class="impact-section" id="impact">
      <div class="impact-image"></div>

      <div class="impact-content">
        <span class="eyebrow light">OUR PURPOSE · SDG 13</span>
        <h2>Act Locally.<br><span>Protect Globally.</span></h2>
        <p>
          Climate action begins with communities.
          Through local campaigns, volunteers can
          contribute to cleaner neighbourhoods,
          greener spaces and environmental awareness.
        </p>

        <ul>
          <li>✓ Support tree plantation activities</li>
          <li>✓ Organize community clean-ups</li>
          <li>✓ Promote climate awareness</li>
          <li>✓ Track environmental outcomes</li>
        </ul>

        <a href="#campaigns" class="btn btn-lime">Join a Campaign ↗</a>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div>
        <span class="eyebrow">BE PART OF THE CHANGE</span>
        <h2>Have an idea for a greener community?</h2>
        <p>Create a campaign and invite others to participate.</p>
      </div>

      <button class="btn btn-primary" id="bottomCreateBtn">
        Create Your Campaign ↗
      </button>
    </section>

  </main>

  <!-- Footer -->
  <footer class="footer">
    <a href="#home" class="logo footer-logo">
      <span class="logo-icon">✳</span>
      <span>CLIMORA<span class="dot">.</span>
        <small>LOCAL CLIMATE ACTION</small>
      </span>
    </a>

    <p>Small Actions. Greener Future.</p>

    <div class="footer-bottom">
      <span>Student Project · Sustainable Development Goal 13</span>
      <span>Built for community participation 🌱</span>
    </div>
  </footer>

  <!-- Create Campaign Modal -->
  <dialog id="campaignModal" class="modal">
    <form id="campaignForm" class="modal-content">

      <button type="button" class="close-btn" data-close>×</button>

      <span class="eyebrow">ORGANIZE LOCAL ACTION</span>
      <h2>Create a Campaign</h2>
      <p>Enter campaign details below.</p>

      <label>Campaign Title
        <input name="title" required maxlength="70"
          placeholder="Example: Green Neighbourhood Drive">
      </label>

      <label>Category
        <select name="category" required>
          <option value="">Select category</option>
          <option>Tree Planting</option>
          <option>Clean-up</option>
          <option>Awareness</option>
          <option>Energy</option>
        </select>
      </label>

      <label>Campaign Description
        <textarea name="description" required maxlength="250"
          placeholder="Describe your campaign..."></textarea>
      </label>

      <div class="form-row">
        <label>Date
          <input name="date" type="date" required>
        </label>

        <label>Location
          <input name="location" required
            placeholder="Enter location">
        </label>
      </div>

      <label>Volunteer Target
        <input name="goal" type="number" min="1" max="10000"
          value="30" required>
      </label>

      <div class="modal-actions">
        <button type="button" class="btn btn-outline" data-close>Cancel</button>
        <button type="submit" class="btn btn-primary">Save Campaign</button>
      </div>
    </form>
  </dialog>

  <!-- Profile Modal -->
  <dialog id="profileModal" class="modal">
    <form id="profileForm" class="modal-content">
      <button type="button" class="close-btn" data-close>×</button>
      <span class="eyebrow">YOUR PROFILE</span>
      <h2>Welcome to Climora</h2>
      <p>Enter a display name for this browser demo.</p>

      <label>Your Name
        <input name="name" required maxlength="40"
          placeholder="Enter your name">
      </label>

      <div class="modal-actions">
        <button type="button" class="btn btn-outline" data-close>Cancel</button>
        <button type="submit" class="btn btn-primary">Continue</button>
      </div>
    </form>
  </dialog>

  <!-- Notification -->
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script src="script.js"></script>
</body>
</html>